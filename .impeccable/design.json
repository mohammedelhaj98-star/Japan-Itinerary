      "css": ".ds-toast{display:inline-flex;align-items:center;gap:14px;padding:10px 10px 10px 16px;border-radius:16px;background:rgba(20,20,18,.92);color:#fff;font:400 14px 'Zen Kaku','Hiragino Sans','Noto Sans JP',system-ui,sans-serif}.ds-toast button{height:34px;padding:0 14px;border:0;border-radius:10px;background:rgba(255,255,255,.16);color:#fff;font:700 14px 'Zen Kaku','Hiragino Sans','Noto Sans JP',system-ui,sans-serif}"
    }
