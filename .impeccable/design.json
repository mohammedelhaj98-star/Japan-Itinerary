  "components": [
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Full-width action at the bottom of a form.",
      "html": "<button class=\"ds-btn-primary\">Add expense</button>",
      "css": ".ds-btn-primary{width:100%;height:52px;border:0;border-radius:14px;background:#141412;color:#fff;font:700 16px 'Zen Kaku','Hiragino Sans','Noto Sans JP',system-ui,sans-serif;transition:transform 160ms cubic-bezier(.23,1,.32,1)}.ds-btn-primary:active{transform:scale(.96)}.ds-btn-primary:focus-visible{outline:2px solid #1e6bff;outline-offset:2px}.ds-btn-primary:disabled{background:#b9b6ae}"
    },
    {
      "name": "Pill",
      "kind": "chip",
      "refersTo": "button-pill",
      "description": "Secondary action, filter or preset; inverts when selected.",
      "html": "<button class=\"ds-pill\">Only Naf</button> <button class=\"ds-pill ds-on\">All four</button>",
      "css": ".ds-pill{height:40px;padding:0 14px;border:0;border-radius:999px;background:#fff;color:#141412;box-shadow:0 0 0 1px rgba(20,20,10,.08);font:700 14px 'Zen Kaku','Hiragino Sans','Noto Sans JP',system-ui,sans-serif}.ds-pill.ds-on{background:#141412;color:#fff;box-shadow:none}.ds-pill:focus-visible{outline:2px solid #1e6bff;outline-offset:2px}"
    },
    {
      "name": "Segmented control",
      "kind": "nav",
      "refersTo": "segment",
      "description": "Two or three views of the same thing.",
      "html": "<div class=\"ds-seg\"><button class=\"ds-on\">Group</button><button>Naf</button><button>NASA</button></div>",
      "css": ".ds-seg{display:inline-flex;gap:2px;padding:3px;border-radius:999px;background:rgba(0,0,0,.05)}.ds-seg button{height:36px;padding:0 16px;border:0;border-radius:999px;background:none;color:#6b6962;font:700 14px 'Zen Kaku','Hiragino Sans','Noto Sans JP',system-ui,sans-serif}.ds-seg button.ds-on{background:#fff;color:#141412;box-shadow:0 1px 3px rgba(0,0,0,.12)}"
    },
    {
      "name": "Card",
      "kind": "card",
      "refersTo": "card",
      "description": "White container on paper for lists and tools.",
      "html": "<div class=\"ds-card\"><small>Group spend so far</small><b>¥109,700</b></div>",
      "css": ".ds-card{background:#fff;border-radius:22px;padding:16px 18px;box-shadow:0 1px 2px rgba(0,0,0,.04),0 10px 26px -18px rgba(0,0,0,.3)}.ds-card small{display:block;font:700 12px 'Zen Kaku',system-ui,sans-serif;color:#6b6962}.ds-card b{display:block;font:400 46px/1 'Instrument Serif',serif;letter-spacing:-.02em;color:#141412}"
    },
    {
      "name": "Pass",
      "kind": "custom",
      "refersTo": "pass",
      "description": "A stop on the day: colour says what it is.",
      "html": "<div class=\"ds-pass\" style=\"--c:#cc5a26\"><small>12:30 · Food</small><b>Kakinoha-zushi lunch</b></div>",
      "css": ".ds-pass{border-radius:22px;padding:18px;color:#fff;background:linear-gradient(165deg,color-mix(in srgb,var(--c) 82%,#fff) 0,var(--c) 36%,color-mix(in srgb,var(--c) 82%,#000) 100%);box-shadow:0 10px 26px -12px rgba(0,0,0,.4)}.ds-pass small{display:block;font:700 12px 'Zen Kaku','Hiragino Sans','Noto Sans JP',system-ui,sans-serif;opacity:.85}.ds-pass b{display:block;font:700 20px 'Zen Kaku','Hiragino Sans','Noto Sans JP',system-ui,sans-serif;margin-top:4px}"
    },
