  "narrative": {
    "northStar": "The Pass Wallet",
    "overview": "The trip lives in a travel wallet. Each stop of the day is a pass: a rounded, colour-filled ticket that says what it is by its colour alone, stacked so the next one is on top. The wallet sits over a live map behind frosted glass. Everything around the passes is quiet paper: warm off-white ground, white cards, near-black ink. Money is set in Instrument Serif, the UI in Zen Kaku Gothic, Japanese in Zen Old Mincho. Colour carries meaning, never mood.",
    "keyCharacteristics": [
      "Warm paper ground (#f6f4ef), white cards, near-black ink; one column up to 460px.",
      "Colour-filled passes with a soft gradient as the day's signature element.",
      "Frosted glass for anything that floats.",
      "Instrument Serif for amounts, Zen Kaku Gothic for UI, Zen Old Mincho for Japanese.",
      "Pills and round buttons for controls; 22px corners for cards and passes; 30px for sheets.",
      "Fast, springy motion on one ease; presses scale to .96."
    ],
    "rules": [
      {
        "name": "The Meaning-Only Rule",
        "body": "Pass, route and people colours are data. They never decorate a heading, a background or an empty state.",
        "section": "colors"
      },
      {
        "name": "The Sunlight Rule",
        "body": "Every text colour clears 4.5:1 on its ground. Small accent-coloured text uses the matching -ink shade.",
        "section": "colors"
      },
      {
        "name": "The Fare Rule",
        "body": "Money is set in Instrument Serif; nothing else is. Tabular figures everywhere digits line up.",
        "section": "typography"
      },
      {
        "name": "The Twelve Floor Rule",
        "body": "No text below 12px, and nothing tappable labelled below 13px.",
        "section": "typography"
      },
      {
        "name": "The One Glass Rule",
        "body": "Glass is only for things that float: controls over the map, the bottom sheet, and the floating tab picker. Content on a page is paper and cards, never glass.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do keep money in Instrument Serif and everything else in Zen Kaku Gothic.",
      "Do use pass colours only to say what a stop is, and route colours only for how you travel.",
      "Do use Ink 3 (#6b6962) as the lightest text colour; use the -ink shades for small coloured text.",
      "Do make every tap target at least 44×44px, enlarging the hit area rather than the visual when needed.",
      "Do use glass only for floating things (map controls, sheets, the tab picker), and cards only on paper.",
      "Do name people and couples in copy (\"Naf\", \"NASA\"), never \"you\", \"me\" or \"us\"."
    ],
    "donts": [
      "Don't put a small uppercase label above a page title.",
      "Don't use text below 12px, or light grey (#86847c) for anything people need to read outdoors.",
      "Don't nest cards inside cards; list rows inside a card are divided by hairlines.",
      "Don't add explanatory paragraphs where the heading already says what the section is.",
      "Don't use emoji as decoration; category emoji are allowed only as the category marker."
    ]
  }
}