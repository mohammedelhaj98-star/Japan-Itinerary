    },
    {
      "name": "Glass round button",
      "kind": "button",
      "refersTo": "button-round",
      "description": "Floating control over the map.",
      "html": "<button class=\"ds-glass\" aria-label=\"Next day\">›</button>",
      "css": ".ds-glass{width:48px;height:48px;border:0;border-radius:50%;font:700 22px system-ui;color:#141412;background:rgba(255,255,255,.72);backdrop-filter:blur(22px) saturate(1.8);-webkit-backdrop-filter:blur(22px) saturate(1.8);box-shadow:0 1px 0 rgba(255,255,255,.9) inset,0 0 0 .5px rgba(0,0,0,.06),0 10px 30px -12px rgba(0,0,0,.28)}"
